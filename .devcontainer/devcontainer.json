// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Medical Context Retrieval",
	// Use Dockerfile to remove stale Yarn APT source before features install
	"build": { "dockerfile": "Dockerfile" },
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {
			"version": "latest",
			"bicepVersion": "latest"
		},
		"ghcr.io/devcontainers/features/terraform:1": {
			"version": "latest",
			"tflint": "latest",
			"terragrunt": "latest"
		}
	},
	// Forward ports for demo and admin interfaces
	"forwardPorts": [
		8866,
		8867,
		8888
	],
	"portsAttributes": {
		"8866": {
			"label": "Demo Interface",
			"onAutoForward": "notify"
		},
		"8867": {
			"label": "Admin Interface",
			"onAutoForward": "notify"
		},
		"8888": {
			"label": "Jupyter Lab",
			"onAutoForward": "notify"
		}
	},
	// Install dependencies after container is created
	//"postCreateCommand": "pip install --no-cache-dir -r requirements.txt && pip install --upgrade ipykernel jupyter notebook && python -m ipykernel install --user --name python3 --display-name 'Python 3' && chmod +x *.sh && dos2unix *.sh 2>/dev/null || sed -i 's/\\r$//' *.sh && mkdir -p cache",
	"postCreateCommand": "bash .devcontainer/setup.sh",
	"mounts": [
		// Mount the Windows C: drive folder inside the container (use WSL path when Docker runs on Linux)
		//"source=/mnt/c/GitHub_paulwu,target=/host-c,type=bind,consistency=cached"
	]
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}